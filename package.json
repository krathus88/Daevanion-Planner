{
    "name": "daevanion-optimizer",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "lint": "eslint .",
        "preview": "vite preview",
        "phone": "vite build && vite preview --host",
        "og:banners": "node scripts/generateOgBanners.ts",
        "pets:data": "node scripts/buildPetAtlas.ts",
        "pets:tiles": "node scripts/buildPetMapTiles.ts",
        "typegen": "npx @chakra-ui/cli typegen ./src/theme/index.ts",
        "knip": "knip",
        "format": "prettier --write .",
        "postinstall": "npm run typegen"
    },
    "dependencies": {
        "@chakra-ui/react": "^3.37.0",
        "@dnd-kit/react": "^0.5.0",
        "@emotion/react": "^11.14.0",
        "@supabase/supabase-js": "^2.118.0",
        "@tanstack/react-router": "^1.170.41",
        "leaflet": "^1.9.4",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-icons": "^5.7.0"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@eslint/js": "^10.0.1",
        "@rolldown/plugin-babel": "^0.2.3",
        "@tanstack/eslint-plugin-router": "^1.162.0",
        "@tanstack/react-router-devtools": "^1.167.2",
        "@tanstack/router-plugin": "^1.168.42",
        "@types/babel__core": "^7.20.5",
        "@types/leaflet": "^1.9.22",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@vitejs/plugin-react": "^6.1.1",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^10.10.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.6",
        "globals": "^17.12.0",
        "knip": "^6.41.0",
        "prettier": "^3.9.9",
        "sharp": "^0.35.5",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.69.0",
        "vite": "^8.3.0"
    }
